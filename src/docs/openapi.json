{
  "openapi": "3.0.3",
  "info": {
    "title": "GoldShop API",
    "version": "1.0.0",
    "description": "Documentation for the existing GoldShop API. Add operations in src/docs/paths."
  },
  "servers": [{ "url": "/api" }],
  "tags": [
    { "name": "🩺 System", "description": "Service health" },
    { "name": "🔐 Auth", "description": "Authentication and account access" },
    { "name": "👤 Users", "description": "Own profile, password and addresses" },
    { "name": "🛡️ User Admin", "description": "Administrative user, address and role management" },
    { "name": "🚫 Bans", "description": "Administrative ban management" },
    { "name": "📚 Categories", "description": "Public category browsing and administrative category management" },
    { "name": "🪙 Prices", "description": "Market prices and price history" },
    { "name": "📦 Products", "description": "Public catalog and administrative product management" },
    { "name": "🛒 Carts", "description": "Authenticated shopping cart" },
    { "name": "🚚 Shipping Methods", "description": "Available delivery and pickup methods" },
    { "name": "💳 Checkouts", "description": "Checkout preview, payment creation and verification" },
    { "name": "📋 Orders", "description": "Customer orders and administrative order management" },
    { "name": "📊 Dashboard", "description": "Administrative store statistics" },
    { "name": "⚙️ Store Settings", "description": "Store checkout availability" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": ["success", "statusCode", "message", "data"],
        "properties": {
          "success": { "type": "boolean", "enum": [true] },
          "statusCode": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "nullable": true }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["success", "statusCode", "message", "errors"],
        "properties": {
          "success": { "type": "boolean", "enum": [false] },
          "statusCode": { "type": "integer", "example": 401 },
          "message": { "type": "string" },
          "errors": {
            "description": "Null in production; details may be included in development.",
            "nullable": true
          }
        }
      }
    }
  }
}
