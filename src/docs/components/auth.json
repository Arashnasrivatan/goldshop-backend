{
  "schemas": {
    "Phone": {
      "type": "string",
      "pattern": "^09[0-9]{9}$",
      "example": "09123456789"
    },
    "Password": {
      "type": "string",
      "format": "password",
      "description": "Use ASCII Latin letters, digits, and @$!%*_?& only. Persian diacritics or other hidden Unicode characters are rejected by the backend.",
      "minLength": 8,
      "maxLength": 24,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[@$!%*_?&])[A-Za-z0-9@$!%*_?&]{8,}$",
      "writeOnly": true,
      "example": "Example1@"
    },
    "LoginPassword": {
      "type": "string",
      "format": "password",
      "description": "Use ASCII Latin letters, digits, and @$!%*_?& only. Persian diacritics or other hidden Unicode characters are rejected by the backend.",
      "minLength": 8,
      "pattern": "^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[@$!%*_?&])[A-Za-z0-9@$!%*_?&]{8,}$",
      "writeOnly": true,
      "example": "Example1@"
    },
    "PhoneRequest": {
      "type": "object",
      "required": ["phone"],
      "properties": { "phone": { "$ref": "#/components/schemas/Phone" } }
    },
    "VerifyOtpRequest": {
      "type": "object",
      "required": ["fullname", "phone", "password", "otp"],
      "properties": {
        "fullname": { "type": "string", "minLength": 3, "maxLength": 50, "example": "Ali Ahmadi" },
        "phone": { "$ref": "#/components/schemas/Phone" },
        "password": { "$ref": "#/components/schemas/Password" },
        "otp": { "type": "string", "minLength": 4, "maxLength": 4, "example": "1234" }
      }
    },
    "LoginRequest": {
      "type": "object",
      "required": ["phone", "password"],
      "properties": {
        "phone": { "$ref": "#/components/schemas/Phone" },
        "password": { "$ref": "#/components/schemas/LoginPassword" }
      }
    },
    "ResetPasswordRequest": {
      "type": "object",
      "required": ["newPassword", "confirmPassword"],
      "properties": {
        "newPassword": { "$ref": "#/components/schemas/Password" },
        "confirmPassword": { "$ref": "#/components/schemas/Password" }
      },
      "description": "confirmPassword must match newPassword."
    },
    "Address": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "title": { "type": "string" },
        "postalCode": { "type": "string" },
        "address": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "formatedLocation": { "type": "string", "nullable": true }
          }
        }
      }
    },
    "AuthUser": {
      "type": "object",
      "properties": {
        "_id": { "type": "string" },
        "fullname": { "type": "string" },
        "phone": { "$ref": "#/components/schemas/Phone" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "USER"] },
        "addresses": { "type": "array", "items": { "$ref": "#/components/schemas/Address" } },
        "isBanned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "description": "Registered user document without password; may include other public model fields."
    },
    "ProfileUser": {
      "type": "object",
      "required": ["id", "fullname", "phone", "role", "addresses"],
      "properties": {
        "id": { "type": "string" },
        "fullname": { "type": "string" },
        "phone": { "$ref": "#/components/schemas/Phone" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "USER"] },
        "addresses": { "type": "array", "items": { "$ref": "#/components/schemas/Address" } }
      }
    },
    "LoginUser": {
      "type": "object",
      "required": ["id", "fullname", "phone", "role"],
      "properties": {
        "id": { "type": "string" },
        "fullname": { "type": "string" },
        "phone": { "$ref": "#/components/schemas/Phone" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "USER"] }
      }
    },
    "SendOtpResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": {
          "type": "object",
          "properties": { "otpCode": { "type": "integer", "description": "Returned only in development." } }
        } } }
      ]
    },
    "VerifyOtpResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": {
          "type": "object", "required": ["user"],
          "properties": { "user": { "$ref": "#/components/schemas/AuthUser" } }
        } } }
      ]
    },
    "LoginResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": {
          "type": "object", "required": ["accessToken", "user"],
          "properties": {
            "accessToken": { "type": "string" },
            "user": { "$ref": "#/components/schemas/LoginUser" }
          }
        } } }
      ]
    },
    "ForgotPasswordResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": {
          "type": "object", "nullable": true,
          "description": "Null in production. In development, contains resetLink.",
          "properties": { "resetLink": { "type": "string", "format": "uri" } }
        } } }
      ]
    },
    "ProfileResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/ProfileUser" } } }
      ]
    },
    "AccessTokenResponse": {
      "allOf": [
        { "$ref": "#/components/schemas/ApiSuccess" },
        { "type": "object", "properties": { "data": {
          "type": "object", "required": ["accessToken"],
          "properties": { "accessToken": { "type": "string" } }
        } } }
      ]
    }
  },
  "responses": {
    "ValidationError": {
      "description": "Request validation failed; errors contains validation messages in development.",
      "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
    },
    "ApiError": {
      "description": "Request rejected by the application.",
      "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
    },
    "PassportUnauthorized": {
      "description": "Passport authentication failed. Default Passport response is plain text Unauthorized.",
      "content": { "text/plain": { "schema": { "type": "string", "example": "Unauthorized" } } }
    },
    "RateLimited": {
      "description": "Request rate limit or OTP cooldown reached.",
      "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
    },
    "ServerError": {
      "description": "Server or SMS service error.",
      "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
    }
  }
}
