{
  "/status": {
    "get": {
      "tags": ["🩺 System"],
      "summary": "Get service status",
      "responses": {
        "200": {
          "description": "Service is running",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean", "example": true },
                  "statusCode": { "type": "integer", "example": 200 },
                  "message": { "type": "string" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "ping": { "type": "string" },
                      "uptime": { "type": "string" },
                      "serverTime": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
