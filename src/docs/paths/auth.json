{
  "/auth/send": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Send registration OTP",
      "description": "Sends a four-digit OTP to a new, non-banned phone number. OTP expires after two minutes. The OTP value is returned only in development.",
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PhoneRequest" } } } },
      "responses": {
        "200": { "description": "OTP sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SendOtpResponse" } } } },
        "400": { "$ref": "#/components/responses/ApiError" },
        "403": { "$ref": "#/components/responses/ApiError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/RateLimited" },
        "500": { "$ref": "#/components/responses/ServerError" }
      }
    }
  },
  "/auth/verify": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Verify OTP and register user",
      "description": "Consumes the registration OTP and creates a user. Does not issue an access token; log in afterward.",
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyOtpRequest" } } } },
      "responses": {
        "201": { "description": "User registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VerifyOtpResponse" } } } },
        "400": { "$ref": "#/components/responses/ApiError" },
        "403": { "$ref": "#/components/responses/ApiError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
    }
  },
  "/auth/login": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Log in with phone and password",
      "description": "Returns an access token and user summary. Also sets an HttpOnly refresh_token cookie (Secure in production, SameSite=Lax).",
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
      "responses": {
        "200": {
          "description": "Logged in; refresh_token cookie set",
          "headers": { "Set-Cookie": { "description": "HttpOnly refresh_token cookie", "schema": { "type": "string" } } },
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
        },
        "401": { "$ref": "#/components/responses/PassportUnauthorized" },
        "403": { "$ref": "#/components/responses/ApiError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
    }
  },
  "/auth/forgot-password": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Request a password reset link",
      "description": "Sends a reset link by SMS in production. In development, the resetLink is returned in data instead. The request has a per-phone cooldown.",
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PhoneRequest" } } } },
      "responses": {
        "200": { "description": "Reset link generated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ForgotPasswordResponse" } } } },
        "400": { "$ref": "#/components/responses/ApiError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/RateLimited" },
        "500": { "$ref": "#/components/responses/ServerError" }
      }
    }
  },
  "/auth/reset-password/{token}": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Set a new password with a reset token",
      "description": "Consumes the reset token, updates the password, and invalidates the stored refresh token. The token is the UUID from the reset link.",
      "parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Password reset token from the SMS link" }],
      "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ResetPasswordRequest" } } } },
      "responses": {
        "200": { "description": "Password reset successful", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiSuccess" } } } },
        "400": { "$ref": "#/components/responses/ApiError" },
        "422": { "$ref": "#/components/responses/ValidationError" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
    }
  },
  "/auth/me": {
    "get": {
      "tags": ["🔐 Auth"],
      "summary": "Get the current user profile",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": { "description": "Current user profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileResponse" } } } },
        "401": { "$ref": "#/components/responses/PassportUnauthorized" },
        "403": { "$ref": "#/components/responses/ApiError" },
        "404": { "$ref": "#/components/responses/ApiError" }
      }
    }
  },
  "/auth/refresh": {
    "get": {
      "tags": ["🔐 Auth"],
      "summary": "Refresh the access token",
      "description": "Reads the HttpOnly refresh_token cookie; a bearer token is not used for this endpoint. The cookie must be valid and match the token stored in Redis.",
      "responses": {
        "200": { "description": "New access token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AccessTokenResponse" } } } },
        "401": { "$ref": "#/components/responses/PassportUnauthorized" },
        "403": { "$ref": "#/components/responses/ApiError" },
        "404": { "$ref": "#/components/responses/ApiError" }
      }
    }
  },
  "/auth/logout": {
    "post": {
      "tags": ["🔐 Auth"],
      "summary": "Log out and clear the refresh token",
      "description": "Clears the refresh_token cookie. If that cookie contains a valid token, the matching Redis token is removed. This route does not require a bearer token.",
      "responses": {
        "200": {
          "description": "Logged out; refresh_token cookie cleared",
          "headers": { "Set-Cookie": { "description": "Expired refresh_token cookie", "schema": { "type": "string" } } },
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiSuccess" } } }
        }
      }
    }
  }
}
