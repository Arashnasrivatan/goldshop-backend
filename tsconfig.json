{
  "compilerOptions": {
    /* ===== Core ===== */
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],

    /* ===== Paths & Output ===== */
    "rootDir": "src",
    "outDir": "dist",

    /* ===== Type Safety ===== */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* ===== JS Interop ===== */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* ===== Build Quality ===== */
    "skipLibCheck": true,
    "removeComments": true,
    "sourceMap": true,

    /* ===== Express / Node ===== */
    "types": ["node", "jest", "multer"],

    /* ===== Emit ===== */
    "declaration": false
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
